# Base URL for API calls. Leave empty so the SPA calls /api/v1/... on its own origin;
# the Vite dev server (5175) and nginx (8201) both proxy /api to Django on 8200.
VITE_API_BASE_URL=

# Show the "Demo accounts" list on the login page in production builds (always shown in dev).
VITE_SHOW_DEMO_ACCOUNTS=false
