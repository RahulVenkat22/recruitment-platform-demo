###############################################################################
# Aimious AI Recruitment Platform -- environment template
#
#   cp .env.example .env      (or: make setup)
#
# One file feeds the Django backend, the Vite build and docker-compose.
# Unknown variables are ignored by every consumer, so it is safe to share.
#
# All values shown are the development defaults: a fresh copy already works
# against the dockerised PostgreSQL on host port 5434 (plan.md section 5.2).
#
# NOTHING IN HERE IS SECRET AS SHIPPED.  Real credentials belong in .env,
# which is git-ignored -- never commit them.
#
# WHERE THIS FILE IS READ FROM
#   * make / scripts/dev.sh  export this file into the environment before any
#     backend or frontend command, so the repo-root .env is what counts (an
#     explicitly exported variable still wins over the file);
#   * docker compose         passes it through `env_file:` and overrides the
#     container-internal values (DATABASE_URL points at the postgres service).
#
# Comments sit on their own line on purpose: django-environ does not strip
# trailing inline comments from values.
###############################################################################

# =============================================================================
# Django
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.dev
# Signs sessions and JWTs (HS256 needs >= 32 bytes; PyJWT warns on shorter keys).
# The placeholder below is public and for development only. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=dev-only-change-me-Kq8vZ2nR4tX7bW1cD5fH9jL3mP6sU0yA8eG2iK4oQ6wS
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local development talks to the compose Postgres published on host port 5434.
# Inside docker-compose the api service overrides this with the SERVICE name:
#   postgres://recruit:recruit@postgres:5432/recruitment_demo
DATABASE_URL=postgres://recruit:recruit@localhost:5434/recruitment_demo
# 5175 = Vite dev server, 8201 = the dockerised nginx frontend.  The SPA
# normally calls /api on its own origin (proxied), so this is a fallback only.
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:8201

# =============================================================================
# Auth (SimpleJWT: access token in memory, refresh token in an httpOnly cookie)
# =============================================================================
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
JWT_REFRESH_REMEMBER_DAYS=14
# true in prod
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# =============================================================================
# Recruitment
# =============================================================================
# future: claude
MATCH_ENGINE=rule_based
# overall match >= this becomes "AI Shortlisted"
AI_SHORTLIST_THRESHOLD=80
SEARCH_RESULT_LIMIT_PER_SOURCE=60
CANDIDATE_SOURCE_PROVIDERS=internal,referral,naukri,linkedin,resume

# =============================================================================
# Seed (manage.py seed_demo)
# =============================================================================
SEED_RANDOM_SEED=42
# timelines end on this date
SEED_ANCHOR_DATE=2026-09-11

# =============================================================================
# Resume library, the LLM provider (OpenAI or Gemini) and vector search (pgvector)
# =============================================================================
# Folder scanned by `python manage.py ingest_resumes` (PDFs; subfolders included).
RESUME_STORAGE_PATH=/absolute/path/to/resume-pdfs
# Below this many extracted characters PyMuPDF has found no usable text layer:
# the PDF is scanned, or empty. The PDF FILE ITSELF goes to the model either
# way, which reads the pages as images, so a scanned resume parses normally;
# this threshold decides only whether there is any text left to fill the
# model's gaps from and to embed the candidate on (and even then only if that
# text reads as the resume body rather than a scanner stamp or a cover sheet).
RESUME_MIN_TEXT_CHARS=200
RESUME_CHUNK_SIZE=1200
RESUME_CHUNK_OVERLAP=150
# Pages of each PDF sent to the model. A provider bills a PDF page as an image,
# so an unbounded document is an unbounded invoice, and a 60-page PDF is almost
# never a 60-page resume: it is a resume with transcripts or a portfolio stapled
# to it. Over the cap the FIRST N pages are sent and the document records a
# warning naming the cap, so nothing ever dead-ends for being long. 12 covers
# the six-to-eight-page resumes this library holds with room to spare. Multiply
# it out before a bulk run: RESUME_UPLOAD_MAX_FILES is 200, so one upload batch
# is up to 200 x 12 billed pages. At least 1: the model is the only parser.
RESUME_LLM_PDF_MAX_PAGES=12
# Megabytes that PDF may occupy AFTER the page cap has been applied. This is not
# a second cost limit; it is the request limit, since an inline attachment
# travels base64-encoded (1.3333x) inside one request body. A PDF whose first
# 12 pages are still larger than this is 600-dpi scans rather than a document:
# it is flagged needs_review with the size and this setting named in the
# reason. The default comes from Gemini's 20 MB inline-data limit with the
# base64 expansion taken off: 14 MiB encodes to 18.7 MiB and fits, where 15
# encoded to 21.0 MiB and did not. RESUME_UPLOAD_MAX_MB (20) is a larger,
# separate limit: an upload it accepts can still be refused here.
RESUME_LLM_PDF_MAX_MB=14

# Which provider parses resumes, analyses JDs, evaluates candidates AND embeds:
# openai or gemini. An unrecognised value stops the server at startup instead of
# falling back. Both read a file, so the PDF ITSELF is sent and the model returns
# the whole structured profile -- it reads a scan exactly as well as a text PDF.
# The WHOLE RESUME -- every page up to RESUME_LLM_PDF_MAX_PAGES, as it looks --
# goes to that vendor, along with the job brief and the candidate excerpts at
# search time. Switching provider changes the embedding space too, so follow it
# with `ingest_resumes --reprocess`.
LLM_PROVIDER=gemini

# OpenAI -- read only when LLM_PROVIDER=openai. NOTHING IN THIS FILE IS SECRET:
# the key belongs in .env, which is git-ignored. OPENAI_SEARCH_MODEL (defaults to
# OPENAI_MODEL) is the search-time evaluator. Use gpt-4o-mini or newer: gpt-3.x
# and plain gpt-4 do not support the structured outputs API and silently fall
# back to function calling. OPENAI_BASE_URL is only for OpenAI-compatible
# gateways; empty = api.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=
# Tried once for the resume parse when OPENAI_MODEL is busy (a 5xx or rate limit
# after the retries). Empty = no fallback.
OPENAI_FALLBACK_MODEL=
OPENAI_BASE_URL=

# Google Gemini -- read only when LLM_PROVIDER=gemini. Same rule about the key.
# GEMINI_API_KEY, not GOOGLE_API_KEY: an ambient GOOGLE_API_KEY belonging to
# another tool is never picked up. Use a model the pinned client knows: the 1.5
# and 2.0 families are gone from its model profiles, so gemini-2.5-flash is the
# oldest flash still recognised. Unlike OpenAI, an empty GEMINI_SEARCH_MODEL does
# NOT fall back to GEMINI_MODEL -- it defaults to the cheaper gemini-2.5-flash-lite,
# so raising GEMINI_MODEL alone does not raise the per-search bill. Set it
# explicitly to use one model for both.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=
# Tried once for the resume parse when GEMINI_MODEL is busy (a 5xx or rate limit
# after the retries); the -lite tier is rarely busy at the same time. Empty = no
# fallback.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Seconds allowed for one structured answer. Empty = 120. Must be a whole
# number of seconds; empty means "the default".
LLM_TIMEOUT_SECONDS=
# Retries after the first attempt. The Gemini client counts total attempts
# instead of retries; resumes/engines/llm.py translates. Empty = 2. Raise to 4
# while a provider is under load: each retry backs off longer than the last.
LLM_MAX_RETRIES=2

# Embeddings run on LLM_PROVIDER as well: text-embedding-3-small on openai,
# gemini-embedding-001 on gemini (empty = that default), both asked for
# EMBEDDING_DIMENSIONS-wide vectors, which is the width baked into the pgvector
# column. Change the model or the provider -> `ingest_resumes --reprocess`;
# change the WIDTH -> also change EMBEDDING_DIMENSIONS and migrate.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# Semantic search: chunks per query vector, candidates returned, LLM evaluations per run.
VECTOR_SEARCH_LIMIT=60
CANDIDATE_RESULT_LIMIT=10
SEMANTIC_JD_ANALYSIS_ENABLED=true
SEMANTIC_RERANK_ENABLED=true
SEMANTIC_RERANK_LIMIT=4
# Search runs execute in a background thread; the UI polls GET /searches/{id}/.
SEARCH_RUN_ASYNC=true

# S3 for the resume PDFs -- leave empty until the credentials exist. Ingestion
# still works (documents wait as pending_upload); `manage.py upload_resumes`
# pushes them once the bucket and keys are set. Pre-signed links expire after
# RESUME_S3_URL_EXPIRY_SECONDS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Optional: S3-compatible endpoint (MinIO, LocalStack)
AWS_S3_ENDPOINT_URL=
RESUME_S3_BUCKET=
RESUME_S3_PREFIX=resumes/
RESUME_S3_URL_EXPIRY_SECONDS=900

# Candidate outreach email (Search results / candidate page -> "Email candidate").
# Leave EMAIL_HOST empty and mail is printed in the server log instead of sent.
# Zoho: smtp.zoho.com, smtp.zoho.in or smtp.zoho.eu -- match the account's data
# centre -- with an app-specific password (My Account -> Security -> App Passwords).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Aimious Talent Team <contactus@example.com>"
# Where candidate replies go; empty = EMAIL_HOST_USER.
EMAIL_REPLY_TO=
# SAFE MODE: while set, every outgoing mail is delivered to this address instead
# of the candidate (the subject says who it was for). Keep it set until go-live.
EMAIL_SAFE_RECIPIENT=
# `{company}` in the templates.
EMAIL_COMPANY_NAME=Aimious

# AI phone calls. The interview script and the assessment run on the project
# LLM; placing a REAL call needs a voice platform. Leave VOICE_PROVIDER empty
# and calls run as a simulated text chat in the browser (same script, same
# assessment). For real calls: VOICE_PROVIDER=vapi, an API key and a phone
# number id from https://vapi.ai, and PUBLIC_BASE_URL reachable from the
# internet (ngrok in development) so Vapi can post the transcript back.
VOICE_PROVIDER=
VOICE_MODEL=
# SAFE MODE: while set, every real call is placed to this number instead of the
# candidate's. Keep it set until go-live.
VOICE_SAFE_NUMBER=
# Region used to parse phone numbers written without a country code.
VOICE_DEFAULT_REGION=IN
PUBLIC_BASE_URL=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# =============================================================================
# Frontend build (read by Vite at BUILD time, not at run time)
# =============================================================================
# empty = same origin: the bundle requests /api/v1/... and Vite (5175) or
# nginx (8201) proxies it to the Django API on 8200.
VITE_API_BASE_URL=
